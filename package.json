{
  "name": "paradoxjs",
  "version": "0.4.10",
  "description": "The batteries I wish vanilla JavaScript came with",
  "keywords": [
    "paradox",
    "paradoxjs",
    "javascript",
    "DOM manipulation",
    "vanilla-js",
    "router",
    "pubsub",
    "utilities",
    "library",
    "browser"
  ],
  "author": {
    "name": "Santiago Rincón",
    "email": "rincorpes@gmail.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.MD",
    "LICENSE"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/rincorpes/paradoxjs.git"
  },
  "bugs": {
    "url": "https://github.com/rincorpes/paradoxjs/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('build', { recursive: true, force: true });\"",
    "clean:test": "node -e \"require('fs').rmSync('build', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:test": "npm run clean:test && tsc -p tsconfig.test-build.json",
    "prepack": "npm run build",
    "test": "npm run build:test && jest --runTestsByPath build/tests/index.test.js",
    "dev": "tsc -w -p tsconfig.build.json"
  },
  "jest": {
    "testEnvironment": "jsdom"
  }
}
