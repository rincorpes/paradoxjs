{
  "name": "penrose-paradox",
  "version": "0.4.10",
  "description": "The batteries I wish vanilla JavaScript came with",
  "keywords": [
    "penrose",
    "paradox",
    "javascript",
    "DOM manipulation",
    "vanilla-js",
    "router",
    "pubsub",
    "utilities",
    "library",
    "browser"
  ],
  "author": {
    "name": "Santiago Rincón",
    "email": "rincorpes@gmail.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.MD",
    "LICENSE"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProjectPenrose/paradox.git"
  },
  "bugs": {
    "url": "https://github.com/ProjectPenrose/paradox/issues"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@types/jest": "^29.5.11",
    "babel-loader": "^9.1.3",
    "bootstrap": "^5.3.2",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.2",
    "sass": "^1.69.5",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('build', { recursive: true, force: true });\"",
    "clean:test": "node -e \"require('fs').rmSync('build', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:test": "npm run clean:test && tsc -p tsconfig.test-build.json",
    "prepack": "npm run build",
    "test": "npm run build:test && jest --runTestsByPath build/tests/index.test.js",
    "dev": "tsc -w -p tsconfig.build.json"
  },
  "jest": {
    "testEnvironment": "jsdom"
  }
}
